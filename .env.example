# 本机 MySQL：请替换用户名和数据库名；密码单独填在下一行。
DATABASE_URL=mysql+pymysql://YOUR_USER@127.0.0.1:3306/film_production?charset=utf8mb4
MYSQL_PASSWORD=
# 需要临时回退 SQLite 时可改为 sqlite:///./film_production.db。
# DeepSeek 官方 OpenAI 兼容地址；密钥只填写在本地 .env，禁止提交。
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-flash

# 本地滚动日志目录；相对路径以 project 为基准。
LOG_DIR=logs

# 未确认拆解结果的本地草稿，不是正式场次表；请保留该目录以恢复草稿。
DRAFT_DIR=.drafts/scripts
